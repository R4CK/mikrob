# NOTE: replace /path/to/marveen (install dir) and /home/USER (home) with your values.
[Unit]
Description=Marveen transcript secret guard (credential shapes in transcripts, scratchpads, logs)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /path/to/marveen/store/transcript-secret-guard.py --alert
# Exit 4 = "findings exist" (already alerted or alert-deduplicated). That is the guard doing its
# job, not a failed unit; every other non-zero code (2 usage, 3 guard blind or run incomplete,
# 5 alert not sent) still marks the unit failed on purpose.
SuccessExitStatus=4
# A oneshot has NO start timeout by default (systemd.service: TimeoutStartSec is disabled for
# Type=oneshot), so a hung read would block every later daily run silently. A full pass measured
# ~250 s on 26k files / 5.7 GB; one hour leaves room for growth and still ends a stall.
TimeoutStartSec=1h
Environment=PATH=/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/USER
Environment=TZ=Europe/Budapest
Nice=15
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
