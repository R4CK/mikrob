# NOTE: replace /path/to/marveen (install dir) and /home/USER (home) with your values.
# Dead-man's switch for transcript-secret-guard.service: a guard that is not run at all (timer off,
# unit killed by its timeout, host asleep) reports nothing. This unit reads the guard's state file
# only (no scan) and pages when the last COMPLETE run is older than 36 hours. --require-state: no
# state file at all is an alarm too (a timer that was never enabled looks exactly like 'no state yet'),
# so enable this unit's timer only after one real --alert run of the guard has written the state.
# It sends its own notice (--alert), so it needs no OnFailure= line.
[Unit]
Description=Marveen transcript secret guard freshness check (has the daily run completed lately?)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /path/to/marveen/store/transcript-secret-guard.py --check-freshness --require-state --alert
Environment=PATH=/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/USER
Environment=TZ=Europe/Budapest
Nice=15
StandardOutput=journal
StandardError=journal
