{
  "name": "marveen",
  "version": "1.32.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/assert-npm-package-manager.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "remote-enroll": "tsx scripts/remote-access-enroll.ts",
    "dashboard-user": "tsx scripts/dashboard-user.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "syntax-check": "node --check web/app.js web/sw.js",
    "smoke": "playwright test --config=playwright.config.ts",
    "ingatlan:typecheck": "tsc -p Ingatlan --noEmit",
    "ingatlan:run": "tsx Ingatlan/src/run.ts",
    "ingatlan:analyze": "tsx Ingatlan/src/analyze.ts",
    "ingatlan:ingest": "tsx Ingatlan/src/run-ingest.ts",
    "ingatlan:webapp": "tsx Ingatlan/src/webapp/run-webapp.ts"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.0.0",
    "google-auth-library": "^11.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "hono": ">=4.12.27 <5",
    "fast-uri": ">=3.1.4 <4",
    "body-parser": ">=2.2.3 <3"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.27 <5",
      "fast-uri": ">=3.1.4 <4",
      "body-parser": ">=2.2.3 <3"
    }
  }
}
