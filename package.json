  "license": "MIT",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/assert-npm-package-manager.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "remote-enroll": "tsx scripts/remote-access-enroll.ts",
    "dashboard-user": "tsx scripts/dashboard-user.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "syntax-check": "node --check web/app.js web/sw.js",
    "smoke": "playwright test --config=playwright.config.ts"
  },
  "engines": {
    "node": ">=20 <24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.224",
    "better-sqlite3": "^11.7.0",
    "cron-parser": "^5.0.0",
    "google-auth-library": "^11.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "hono": ">=4.12.27 <5",
    "fast-uri": ">=3.1.4 <4",
    "body-parser": ">=2.2.3 <3"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.27 <5",
      "fast-uri": ">=3.1.4 <4",
      "body-parser": ">=2.2.3 <3"
    }
  }
